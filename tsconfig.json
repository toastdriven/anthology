{
  "compilerOptions": {
    // Environment setup & latest features
    // "DOM" is required for correct `Response`/`Request`/`fetch` Body typings
    // (without it, Bun's global `Response`/`Request` fall back to
    // `undici-types`, whose `.json()` returns `Promise<unknown>` instead of
    // `Promise<any>` — which is what was causing the `'body' is of type
    // 'unknown'` errors under `tests/views/*.test.ts`).
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
